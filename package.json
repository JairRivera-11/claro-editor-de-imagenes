{
  "name": "rembg-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editor de fondos con rmbg, Express y sharp",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "multer": "2.4.0",
    "rmbg": "0.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@vercel/nft": "1.11.0",
    "esbuild": "0.28.2",
    "nodemon": "3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/**",
      ".cache/**",
      "tests/**",
      "public/blob-client.js"
    ]
  },
  "overrides": {
    "rmbg": {
      "sharp": "$sharp"
    }
  }
}
