PORT=3000
# Vercel convierte birefnet-lite a birefnet-lite-efficient y fuerza ONNX_THREADS=1.
# Motor local validado. Alternativas: birefnet, briaai (requiere licencia comercial).
SEGMENTATION_ENGINE=birefnet-lite
ONNX_THREADS=4
# BIREFNET_MODEL_DIR=/ruta/a/pesos/verificados
# Vercel descarga automáticamente en /tmp. Local: npm run models:download.
# BIREFNET_AUTO_DOWNLOAD=1
# Local por defecto. Vercel activa Blob automáticamente.
STORAGE_DRIVER=local
# Conecta un almacén PUBLIC de Vercel Blob al proyecto para obtener este valor.
BLOB_READ_WRITE_TOKEN=
# Genera un secreto aleatorio en Vercel para proteger /api/cron/cleanup.
CRON_SECRET=
